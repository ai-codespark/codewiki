# DeepWiki Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Embedder Configuration
DEEPWIKI_EMBEDDER_TYPE=litellm
# Options: openai, google, litellm, ollama, azure

# LiteLLM Configuration (if using DEEPWIKI_EMBEDDER_TYPE=litellm)
LITELLM_BASE_URL=https://your-litellm-server.com
LITELLM_API_KEY=your-litellm-api-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Google AI Configuration
GOOGLE_API_KEY=your-google-api-key

# Azure OpenAI Configuration (optional)
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_VERSION=2024-02-15-preview

# OpenRouter Configuration (optional)
OPENROUTER_API_KEY=your-openrouter-api-key

# Ollama Configuration (optional)
OLLAMA_HOST=http://localhost:11434

# Backend Server URL (for frontend)
SERVER_BASE_URL=http://localhost:8001

# AWS Configuration (optional, for Bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Cloudflare Configuration
# npx wrangler whoami
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# GCP Configuration
# gcloud auth print-access-token
GCP_PROJECT_ID=your-project-id
GCP_API_TOKEN=your-api-token

# Note: This is an example file. Copy to .env.local and add your actual values.
# Never commit .env.local to version control!
